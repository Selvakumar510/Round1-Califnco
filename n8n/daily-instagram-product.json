      "id": "a709972a-c90c-4f21-8ffc-0ee37be5ab73",
      "name": "Read product calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [440, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(({ json }) => json).filter((row) => row.Name && row.Description);\nif (rows.length === 0) throw new Error('The Products sheet has no rows with Name and Description.');\nconst dayNumber = Math.floor(Date.now() / 86400000);\nconst row = rows[dayNumber % rows.length];\nreturn [{ json: { name: String(row.Name), description: String(row.Description), imagePrompt: String(row.ImagePrompt || `${row.Name}, ${row.Description}`) } }];"
      },
      "id": "91ed5df8-34fa-4b3e-8d81-f5c6f5f34e1d",
      "name": "Select daily product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', messages: [{ role: 'system', content: 'Write one warm, concise Instagram product caption. Add 5 relevant hashtags. Do not make medical, safety, or performance claims unless they appear in the provided description. Return only the caption.' }, { role: 'user', content: `Product: ${$('Select daily product').item.json.name}\\nDetails: ${$('Select daily product').item.json.description}` }], temperature: 0.7 }) }}",
        "options": {}
      },
      "id": "9cfc466d-c93e-48c5-8c92-e6c72e4f9a92",
      "name": "Generate caption with Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_HUGGING_FACE_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ inputs: `Photorealistic premium e-commerce product photography for ${$('Select daily product').item.json.imagePrompt}. Product centered on a clean pale aqua studio background, soft natural daylight, realistic materials, editorial composition, square image, no text, no logos, no watermark.` }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "37ccce5f-9701-4e82-973c-15d188dc13cf",
      "name": "Generate product image",
